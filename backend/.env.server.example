APP_RUNTIME_MODE=server
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://159.75.81.13:9999

DATABASE_URL=sqlite:///./hagsyn_graph.db

AUTH_USERNAME=hagsyn-admin
AUTH_PASSWORD=change-this-password
AUTH_TOKEN=change-this-token-to-a-long-random-string
